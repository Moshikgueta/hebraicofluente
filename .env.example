# Hebraico Fluente - os segredos.
#
# NADA daqui entra no repositório. Este arquivo é a LISTA dos nomes, não os
# valores. Em produção eles vivem no painel da Cloudflare:
#   Workers & Pages → hebraico-fluente → Settings → Variables and Secrets
#   → tipo "Secret" (não "Text": Text aparece em tela e em log).
#
# Localmente, copie para .dev.vars (que está no .gitignore) e rode
# `npx wrangler dev`.
#
# ⚠ Nenhum destes nomes pode aparecer em wrangler.toml. Cada publicação
# reaplica a lista [vars] de lá, e um nome repetido nos dois faz a publicação
# falhar. A regra e o motivo estão escritos no próprio wrangler.toml.


# ── sessões ───────────────────────────────────────────────────────────────
# Assina o cookie de sessão. Trocar este valor desloga TODO MUNDO na hora -
# o que é exatamente o que se quer num incidente, e um acidente caro fora dele.
# Gere com: openssl rand -base64 48
SESSION_SECRET=


# ── Mercado Pago ──────────────────────────────────────────────────────────
# Painel: https://www.mercadopago.com.br/developers → Suas integrações →
# a aplicação → Credenciais.
#
# Existem DOIS pares: teste e produção. O token de teste começa com
# TEST-. Com ele, MP_SANDBOX=1 no wrangler.toml; com o de produção, 0.
# Subir o token de produção esquecendo MP_SANDBOX=1 manda todo comprador para
# um checkout que não cobra - e isso passa despercebido por semanas.
MP_ACCESS_TOKEN=

# Assina os avisos de webhook. Sai de: a aplicação → Webhooks → Configurar
# notificações → "Assinatura secreta".
#
# Sem ele, /api/pay/webhook RECUSA tudo (worker/src/lib/mercadopago.js). É
# deliberado: um webhook sem verificação é uma rota pública que libera curso.
MP_WEBHOOK_SECRET=


# ── e-mail (Resend) ───────────────────────────────────────────────────────
# Manda o link de "esqueci minha senha". SEM ESTA CHAVE ninguém recupera a
# senha sozinho: o site funciona inteiro e essa porta fica fechada, o que
# /api/health reporta como "email": false.
#
# Como conseguir, uma vez só:
#   1. https://resend.com → criar conta. O plano gratuito manda 3.000
#      mensagens por mês, de sobra para recuperação de senha.
#   2. Domains → Add Domain → hebraicofluente.com.br. Ela mostra alguns
#      registros DNS; a zona já está na Cloudflare, então é colar lá. A
#      verificação leva de minutos a algumas horas.
#   3. API Keys → Create → permissão "Sending access". A chave começa com
#      `re_` e aparece uma vez só.
#   4. Cole no painel do Worker como Secret, com o nome abaixo.
#
# O REMETENTE não é segredo e mora no wrangler.toml, como EMAIL_FROM. Ele
# precisa ser do domínio verificado no passo 2: um @gmail.com ali é recusado
# pela Resend com 403, e o sintoma é "ninguém recebe o link" com todo o resto
# funcionando.
RESEND_API_KEY=


# ── o painel de gravação ──────────────────────────────────────────────────
# ADMIN_EMAILS: os e-mails (separados por vírgula) das contas que podem gravar,
# substituir e remover pronúncias em /admin/gravar. Não é segredo - quem entra
# ainda precisa da senha da conta -, então mora no wrangler.toml [vars]. Vazio,
# ninguém é administrador e o painel responde "sem acesso".


# ── o que NÃO vai em lugar nenhum ─────────────────────────────────────────
# Não existe variável de preço. O preço vem de data/courses.json, lido pelo
# Worker. Se um dia aparecer um PRICE_BRL por aqui, alguém duplicou a fonte -
# apague.
#
# RESEND_BASE existe só para o `npm test` mandar o envio para um servidor de
# mentira. Não vai para o painel nem para o wrangler.toml.
