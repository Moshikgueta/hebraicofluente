# Minha Caravana Digital: variaveis de ambiente. Copie para .env.local se quiser.
# Nada aqui tem valor real: segredo de verdade vive no painel do provedor.

# Segredo do servidor (32+ caracteres). Assina o freio, cifra os codigos de
# convite e entra no HMAC dos enderecos. Obrigatorio em producao: sem ele o
# servidor nao sobe. Gerar: openssl rand -base64 48
MCD_SECRET=

# Endereco publico da plataforma. Os links de convite e de definir senha saem
# daqui, nunca do cabecalho Host da requisicao.
MCD_PUBLIC_URL=http://localhost:3100

# Postgres de producao (Neon, Supabase ou Hyperdrive na Cloudflare). Vazio = PGlite local.
DATABASE_URL=
MCD_DB_POOL=5

# PGlite local (desenvolvimento). Padrao: .data/pglite
MCD_PGLITE_DIR=

# Iteracoes do PBKDF2-SHA256 das senhas. Padrao 600000 (OWASP). As senhas guardam
# o proprio numero de iteracoes: mudar aqui nao invalida as antigas.
MCD_PBKDF2_ITERATIONS=
