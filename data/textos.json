      "tipoPt": "Mensagem sem pontinhos",
      "revisado": false,
      "semPontos": true,
      "introPt": "Ninguém põe nikud numa mensagem de celular. Esta chega como chegaria de verdade: só as letras. Se travar, toque em \"Mostrar os pontos\".",
      "linhas": [
        {
          "he": "שָׁלוֹם, דָּנִי!",
          "translit": "shalom, Dani!",
          "pt": "Oi, Dani!"
        },
        {
          "he": "אֲנִי בַּדֶּרֶךְ הַבַּיְתָה.",
          "translit": "aní badérech habáyta.",
          "pt": "Estou a caminho de casa."
        },
        {
          "he": "יֵשׁ לִי סֵפֶר חָדָשׁ.",
          "translit": "yesh li séfer chadash.",
          "pt": "Tenho um livro novo."
        },
        {
          "he": "אַתָּה בַּבַּיִת?",
          "translit": "atá babáyit?",
          "pt": "Você está em casa?"
        },
        {
          "he": "לַיְלָה טוֹב!",
          "translit": "láila tov!",
          "pt": "Boa noite!"
        }
      ],
      "novas": [
        {
          "he": "דָּנִי",
          "translit": "Dani",
          "pt": "Dani (nome)"
        },
        {
          "he": "הַבַּיְתָה",
          "translit": "habáyta",
          "pt": "para casa"
        },
        {
          "he": "יֵשׁ לִי",
          "translit": "yesh li",
          "pt": "eu tenho"
        }
      ],
      "perguntas": [
        {
          "t": "escolha",
          "q": "Para onde a pessoa está indo?",
          "opcoes": [
            "Para a livraria",
