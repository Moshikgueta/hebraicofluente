{
  "textos": [
    {
      "modulo": 3,
      "tituloPt": "O bilhete na geladeira",
      "tipoPt": "Bilhete",
      "revisado": false,
      "introPt": "Você acorda cedo e acha um bilhete preso na geladeira. É a primeira coisa que você lê inteira em hebraico.",
      "linhas": [
        {
          "he": "שָׁלוֹם, דָּנָה!",
          "translit": "shalom, Dana!",
          "pt": "Olá, Dana!"
        },
        {
          "he": "הַיּוֹם יוֹם גָּדוֹל!",
          "translit": "hayom yom gadol!",
          "pt": "Hoje é um grande dia!"
        },
        {
          "he": "הַלֶּחֶם טָרִי, וְהַתֵּה חַם.",
          "translit": "haléchem tari, vehate cham.",
          "pt": "O pão está fresco, e o chá está quente."
        },
        {
          "he": "הַיֶּלֶד יָשֵׁן.",
          "translit": "hayéled yashen.",
          "pt": "O menino está dormindo."
        },
        {
          "he": "אִמָּא",
          "translit": "imá",
          "pt": "Mamãe"
        }
      ],
      "novas": [
        {
          "he": "דָּנָה",
          "translit": "Dana",
          "pt": "Dana (nome)"
        },
        {
          "he": "חַם",
          "translit": "cham",
          "pt": "quente"
        },
        {
          "he": "יָשֵׁן",
          "translit": "yashen",
          "pt": "dorme, está dormindo"
        },
        {
          "he": "הַ־",
          "translit": "ha-",
          "pt": "o, a (o artigo, grudado na palavra)"
        },
        {
          "he": "וְ־",
          "translit": "ve-",
          "pt": "e (grudado na palavra)"
        }
      ],
      "perguntas": [
        {
          "t": "escolha",
          "q": "Quem escreveu o bilhete?",
          "opcoes": [
            "A Dana",
            "A mãe",
            "O menino"
          ],
          "certa": 1,
          "porque": "O bilhete termina com {{אִמָּא}}: é a assinatura da mãe."
        },
        {
          "t": "vf",
          "q": "O chá está frio.",
          "certa": false,
          "porque": "{{חַם}} é quente: o chá está quente."
        },
        {
          "t": "escolha",
          "q": "O que o menino está fazendo?",
          "opcoes": [
            "Tomando chá",
            "Comprando pão",
            "Dormindo"
          ],
          "certa": 2,
          "porque": "{{יָשֵׁן}}: está dormindo."
        },
        {
          "t": "vf",
          "q": "O pão é fresco.",
          "certa": true,
          "porque": "{{טָרִי}} é fresco."
        }
      ]
    },
    {
      "modulo": 4,
      "tituloPt": "Uma mensagem da montanha",
      "tipoPt": "Mensagem de WhatsApp",
      "revisado": false,
      "introPt": "A Noa foi passear e mandou uma mensagem para o Dan. No celular, o hebraico chega assim: frases curtas, uma embaixo da outra.",
      "linhas": [
        {
          "he": "שָׁלוֹם, דָּן! מָה נִשְׁמַע?",
          "translit": "shalom, Dan! ma nishma?",
          "pt": "Oi, Dan! Tudo bem?"
        },
        {
          "he": "אֲנִי עַל הָהָר.",
          "translit": "aní al hahar.",
          "pt": "Estou na montanha."
        },
        {
          "he": "אֵיזֶה שֶׁקֶט!",
          "translit": "eize shéket!",
          "pt": "Que silêncio!"
        },
        {
          "he": "הַנָּהָר קַר.",
          "translit": "hanahar kar.",
          "pt": "O rio está frio."
        },
        {
          "he": "אֲנִי רוֹצָה עוֹד יוֹם!",
          "translit": "aní rotsá od yom!",
          "pt": "Quero mais um dia!"
        },
        {
          "he": "נוֹעָה",
          "translit": "Noa",
          "pt": "Noa"
        }
      ],
      "novas": [
        {
          "he": "דָּן",
          "translit": "Dan",
          "pt": "Dan (nome)"
        },
        {
          "he": "נוֹעָה",
          "translit": "Noa",
          "pt": "Noa (nome)"
        },
        {
          "he": "מָה נִשְׁמַע?",
          "translit": "ma nishma?",
          "pt": "tudo bem? (literalmente, \"o que se ouve?\")"
        },
        {
          "he": "אֵיזֶה",
          "translit": "eize",
          "pt": "que...! (numa exclamação)"
        },
        {
          "he": "קַר",
          "translit": "kar",
          "pt": "frio"
        },
        {
          "he": "רוֹצָה",
          "translit": "rotsá",
          "pt": "quer (no feminino; {{רוֹצֶה}} é o masculino)"
        }
      ],
      "perguntas": [
        {
          "t": "escolha",
          "q": "Onde a Noa está?",
          "opcoes": [
            "Na montanha",
            "No mercado",
            "Em casa"
          ],
          "certa": 0,
          "porque": "{{עַל הָהָר}}: na montanha (literalmente, em cima dela)."
        },
        {
          "t": "vf",
          "q": "Lá é barulhento.",
          "certa": false,
          "porque": "{{אֵיזֶה שֶׁקֶט!}} é \"que silêncio!\"."
        },
        {
          "t": "escolha",
          "q": "Como está o rio?",
          "opcoes": [
            "Quente",
            "Grande",
            "Frio"
          ],
          "certa": 2,
          "porque": "{{קַר}} é frio."
        },
        {
          "t": "vf",
          "q": "A Noa quer ficar mais um dia.",
          "certa": true,
          "porque": "{{עוֹד יוֹם}} é \"mais um dia\"."
        }
      ]
    },
    {
      "modulo": 5,
      "tituloPt": "Sábado de manhã",
      "tipoPt": "Mensagem no grupo da família",
      "revisado": false,
      "introPt": "O alfabeto está completo. É sábado, e chega a primeira mensagem do dia no grupo da família.",
      "linhas": [
        {
          "he": "בֹּקֶר טוֹב, מִשְׁפָּחָה!",
          "translit": "bóker tov, mishpachá!",
          "pt": "Bom dia, família!"
        },
        {
          "he": "הַיּוֹם שַׁבָּת.",
          "translit": "hayom shabat.",
          "pt": "Hoje é sábado."
        },
        {
          "he": "אִמָּא בַּגַּן, וְהַכֶּלֶב רוֹצֶה לָלֶכֶת.",
          "translit": "imá bagan, vehakélev rotsé laléchet.",
          "pt": "A mãe está no jardim, e o cachorro quer passear."
        },
        {
          "he": "יֵשׁ קָפֶה וְלֶחֶם טָרִי.",
          "translit": "yesh kafé veléchem tari.",
          "pt": "Tem café e pão fresco."
        },
        {
          "he": "מִי בָּא?",
          "translit": "mi ba?",
          "pt": "Quem vem?"
        },
        {
          "he": "אַבָּא",
          "translit": "abá",
          "pt": "Papai"
        }
      ],
      "novas": [
        {
          "he": "בַּ־",
          "translit": "ba-",
          "pt": "no, na (grudado na palavra)"
        },
        {
          "he": "יֵשׁ",
          "translit": "yesh",
          "pt": "tem, há"
        },
        {
          "he": "בָּא",
          "translit": "ba",
          "pt": "vem"
        }
      ],
      "perguntas": [
        {
          "t": "escolha",
          "q": "Que dia é hoje?",
          "opcoes": [
            "Domingo",
            "Sábado",
            "Segunda-feira"
          ],
          "certa": 1,
          "porque": "{{הַיּוֹם שַׁבָּת}}: hoje é sábado."
        },
        {
          "t": "escolha",
          "q": "Onde está a mãe?",
          "opcoes": [
            "No jardim",
            "Em casa",
            "Na rua"
          ],
          "certa": 0,
          "porque": "{{בַּגַּן}}: no jardim."
        },
        {
          "t": "vf",
          "q": "O cachorro quer dormir.",
          "certa": false,
          "porque": "{{לָלֶכֶת}} é ir, caminhar: o cachorro quer passear."
        },
        {
          "t": "escolha",
          "q": "Quem mandou a mensagem?",
          "opcoes": [
            "A mãe",
            "O cachorro",
            "O pai"
          ],
          "certa": 2,
          "porque": "A mensagem termina com {{אַבָּא}}."
        }
      ]
    },
    {
