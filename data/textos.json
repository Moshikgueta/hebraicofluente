    {
      "modulo": 3,
      "tituloPt": "Tem pão?",
      "tipoPt": "Conversa no WhatsApp",
      "revisado": true,
      "introPt": "Dana acorda, a casa está em silêncio, e ela manda uma mensagem para a mãe, que já saiu. É a primeira conversa que você lê inteira em hebraico.",
      "linhas": [
        {
          "quem": "Dana",
          "he": "אִמָּא, יֵשׁ לֶחֶם?",
          "translit": "imá, yesh léchem?",
          "pt": "Mãe, tem pão?"
        },
        {
          "quem": "Mãe",
          "he": "יֵשׁ לֶחֶם טָרִי, וְיֵשׁ גַּם תֵּה חַם.",
          "translit": "yesh léchem tari, veyesh gam te cham.",
          "pt": "Tem pão fresco, e tem chá quente também."
        },
        {
          "quem": "Dana",
          "he": "תּוֹדָה! וְיוֹנָתָן?",
          "translit": "todá! veYonatan?",
          "pt": "Obrigada! E o Yonatan?"
        },
        {
          "quem": "Mãe",
          "he": "הוּא יָשֵׁן.",
          "translit": "hu yashen.",
          "pt": "Ele está dormindo."
        }
      ],
      "novas": [
        {
          "he": "דָּנָה",
          "translit": "Dana",
          "pt": "Dana (nome)"
        },
        {
          "he": "יוֹנָתָן",
          "translit": "Yonatan",
          "pt": "Yonatan (nome)"
        },
        {
          "he": "גַּם",
          "translit": "gam",
          "pt": "também"
        },
        {
          "he": "חַם",
          "translit": "cham",
          "pt": "quente"
        },
        {
          "he": "יָשֵׁן",
          "translit": "yashen",
          "pt": "dorme, está dormindo"
        },
        {
          "he": "וְ־",
          "translit": "ve-",
          "pt": "e (grudado na palavra)"
        }
      ],
      "perguntas": [
