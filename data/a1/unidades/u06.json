      {
        "quem": "Noa",
        "he": "זֶה אֵיתָן, הָאָח שֶׁלִי. הוּא גָר בְּחֵיפָה.",
        "translit": "ze Eitán, haách shelí. hu gar beCháifa.",
        "pt": "Este é o Eitan, o meu irmão. Ele mora em Haifa."
      },
      {
        "quem": "Tom",
        "he": "וְיֵשׁ לָךְ כֶּלֶב?",
        "translit": "veyésh lach kélev?",
        "pt": "E você tem cachorro?"
      },
      {
        "quem": "Noa",
        "he": "לֹא, אֵין לִי כֶּלֶב. יֵשׁ לִי חָתוּל! וּלְךָ?",
        "translit": "lo, ein li kélev. yesh li chatúl! ulechá?",
        "pt": "Não, não tenho cachorro. Tenho um gato! E você?"
      },
      {
        "quem": "Tom",
        "he": "אֵין לִי חָתוּל. אֲבָל לַהוֹרִים שֶׁלִי יֵשׁ כֶּלֶב גָדוֹל.",
        "translit": "ein li chatúl. avál lahorím shelí yesh kélev gadól.",
