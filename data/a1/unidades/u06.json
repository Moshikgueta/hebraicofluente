  "gramatica": [
    {
      "tituloPt": "יֵשׁ e אֵין = há e não há",
      "textoPt": "יֵשׁ חָלָב בַּמְקָרֵר (há leite na geladeira). אֵין חָלָב (não há leite). Não mudam com gênero nem número."
    },
    {
      "tituloPt": "Não existe o verbo \"ter\"",
      "textoPt": "\"Eu tenho\" se diz יֵשׁ לִי (\"há para mim\"). \"Eu não tenho\" = אֵין לִי.",
      "erroPt": "Procurar um verbo \"ter\" e conjugá-lo. Não há. \"Eu tenho um irmão\" = יֵשׁ לִי אָח. \"Ela tem um gato\" = יֵשׁ לָה חָתוּל."
    },
    {
      "tituloPt": "\"Meu\" vem depois da coisa",
      "textoPt": "\"A minha casa\" = הַבַּיִת שֶׁלִי. Para dizer \"o meu...\", a coisa leva הַ. Sem הַ (חָבֵר שֶׁלִי) é \"um amigo meu\".",
      "erroPt": "Pôr o \"meu\" antes (שֶׁלִי בַּיִת). A ordem é a coisa, e depois שֶׁלִי: הַכֶּלֶב שֶׁלִי, הַחֲבֵרָה שֶׁלוֹ."
    },
    {
      "tituloPt": "אַבָּא e אִמָא não levam הַ",
      "textoPt": "אִמָא שֶׁלִי, אַבָּא שֶׁלָה. E com הַ, o לְ funde como o בְּ: לְ + הַ = לַ (לַהוֹרִים שֶׁלִי)."
    }
  ],
  "dialogo": {
    "tituloPt": "Tom e Noa, com uma foto",
    "linhas": [
      {
        "quem": "Tom",
        "he": "נֹעָה, יֵשׁ לָךְ אַחִים?",
