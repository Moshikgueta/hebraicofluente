  "gramatica": [
    {
      "tituloPt": "יֵשׁ e אֵין = há e não há",
      "textoPt": "יֵשׁ חָלָב בַּמְּקָרֵר (há leite na geladeira). אֵין חָלָב (não há leite). Não mudam com gênero nem número."
    },
    {
      "tituloPt": "Não existe o verbo \"ter\"",
      "textoPt": "\"Eu tenho\" se diz יֵשׁ לִי (\"há para mim\"). \"Eu não tenho\" = אֵין לִי.",
      "erroPt": "Procurar um verbo \"ter\" e conjugá-lo. Não há. \"Eu tenho um irmão\" = יֵשׁ לִי אָח. \"Ela tem um gato\" = יֵשׁ לָהּ חָתוּל."
    },
    {
      "tituloPt": "\"Meu\" vem depois, e a coisa leva הַ",
      "textoPt": "\"A minha casa\" = הַבַּיִת שֶׁלִּי.",
      "erroPt": "Pôr o \"meu\" antes (שֶׁלִּי בַּיִת) ou esquecer o הַ. A ordem é a coisa com הַ, e depois שֶׁלִּי: הַכֶּלֶב שֶׁלִּי, הַחֲבֵרָה שֶׁלּוֹ."
    },
    {
      "tituloPt": "אַבָּא e אִמָּא não levam הַ",
      "textoPt": "אִמָּא שֶׁלִּי, אַבָּא שֶׁלָּהּ. E com הַ, o לְ funde como o בְּ: לְ + הַ = לַ (לַהוֹרִים שֶׁלִּי)."
    }
  ],
  "dialogo": {
    "tituloPt": "Tom e Noa, com uma foto",
    "linhas": [
      {
        "quem": "Tom",
        "he": "נֹעָה, יֵשׁ לָךְ אַחִים?",
        "translit": "Noa, yesh lach achim?",
        "pt": "Noa, você tem irmãos?"
      },
      {
        "quem": "Noa",
        "he": "כֵּן, יֵשׁ לִי אָח וְאָחוֹת.",
        "translit": "ken, yesh li ach veachot.",
        "pt": "Tenho, um irmão e uma irmã."
      },
      {
        "quem": "Tom",
        "he": "מִי זֶה בַּתְּמוּנָה?",
        "translit": "mi ze batmuná?",
        "pt": "Quem é este na foto?"
      },
      {
        "quem": "Noa",
        "he": "זֶה אֵיתָן, הָאָח שֶׁלִּי. הוּא גָּר בְּחֵיפָה.",
        "translit": "ze Eitan, haach sheli. hu gar beCheifa.",
        "pt": "Este é o Eitan, o meu irmão. Ele mora em Haifa."
      },
      {
        "quem": "Tom",
        "he": "וְיֵשׁ לָךְ כֶּלֶב?",
        "translit": "veyesh lach kélev?",
        "pt": "E você tem cachorro?"
      },
      {
        "quem": "Noa",
        "he": "לֹא, אֵין לִי כֶּלֶב. יֵשׁ לִי חָתוּל! וּלְךָ?",
        "translit": "lo, ein li kélev. yesh li chatul! ulechá?",
        "pt": "Não, não tenho cachorro. Tenho um gato! E você?"
      },
      {
        "quem": "Tom",
        "he": "אֵין לִי חָתוּל. אֲבָל לַהוֹרִים שֶׁלִּי יֵשׁ כֶּלֶב גָּדוֹל.",
        "translit": "ein li chatul. aval lahorim sheli yesh kélev gadol.",
        "pt": "Não tenho gato. Mas os meus pais têm um cachorro grande."
      }
    ],
