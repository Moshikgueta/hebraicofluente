  "gramatica": [
    {
      "tituloPt": "O presente muda com o gênero e o número, não com a pessoa",
      "textoPt": "אֲנִי / אַתָּה / הוּא לוֹמֵד: a mesma palavra. O que muda é homem ou mulher, um ou vários: אֲנִי לוֹמֵד (homem), אֲנִי לוֹמֶדֶת (mulher).",
      "erroPt": "O português conjuga pela pessoa (estudo, estuda, estudamos). O hebraico, no presente, conjuga por quem é e quantos. Uma mulher diz אֲנִי לוֹמֶדֶת, nunca אֲנִי לוֹמֵד."
    },
    {
      "tituloPt": "O desenho das 4 formas",
      "textoPt": "Na maioria dos verbos: _וֹ_ֵ_ · _וֹ_ֶ_ֶת · _וֹ_ְ_ִים · _וֹ_ְ_וֹת. É o mesmo final do adjetivo (־ִים / ־וֹת). גָּר e מְדַבֵּר fogem do desenho e são aprendidos como estão."
    },
    {
      "tituloPt": "\"Em\" é בְּ־, grudado",
      "textoPt": "בְּתֵל אָבִיב, בִּירוּשָׁלַיִם, בִּבְרָזִיל. Para dizer que você FALA uma língua (sabe falar), não precisa de preposição: אֲנִי מְדַבֵּר עִבְרִית. Para dizer EM que língua algo é dito ou escrito, usa-se בְּ: כּוֹתֵב בְּעִבְרִית.",
      "erroPt": "Procurar uma palavra separada para \"em\". Ela é uma letra grudada: \"em Tel Aviv\" = בְּתֵל אָבִיב."
    }
