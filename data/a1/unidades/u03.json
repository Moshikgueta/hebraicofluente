  "gramatica": [
    {
      "tituloPt": "O plural",
      "textoPt": "Masculino ganha ־ִים, feminino ganha ־וֹת: תִּיק → תִּיקִים, מַתָּנָה → מַתָּנוֹת. O ־ָה ou ־ֶת do feminino cai antes do ־וֹת (מַתָּנָה → מַתָּנוֹת, מַחְבֶּרֶת → מַחְבָּרוֹת), e as vogais de dentro podem mudar (יֶלֶד → יְלָדִים). Aprenda o plural junto com a palavra."
    },
    {
      "tituloPt": "O adjetivo vem depois e concorda",
      "textoPt": "תִּיק גָּדוֹל, מְנוֹרָה גְּדוֹלָה, תִּיקִים גְּדוֹלִים. Atenção: שֻׁלְחָנוֹת e כִּסְאוֹת terminam em ־וֹת mas são masculinos: שֻׁלְחָנוֹת גְּדוֹלִים, כִּסְאוֹת חֲדָשִׁים. O adjetivo segue o gênero da palavra, não a terminação."
    },
    {
      "tituloPt": "\"O/a\" é הַ־, e vai nas duas palavras",
      "textoPt": "\"O livro novo\" = הַסֵּפֶר הֶחָדָשׁ.",
      "erroPt": "Em português o artigo vai uma vez só. Em hebraico vai duas: הַסֵּפֶר הֶחָדָשׁ."
    },
    {
      "tituloPt": "Com artigo só no substantivo, vira frase",
      "textoPt": "הַסֵּפֶר חָדָשׁ = \"o livro é novo\". É a frase sem \"ser\" da Unidade 1, agora com adjetivo.",
      "erroPt": "הַסֵּפֶר הֶחָדָשׁ = \"o livro novo\"; הַסֵּפֶר חָדָשׁ = \"o livro é novo\". A diferença é um ה."
    },
    {
      "tituloPt": "Os pronomes do plural",
      "textoPt": "\"Vocês\" se divide: אַתֶּם (homens, ou grupo misto) e אַתֶּן (só mulheres). O mesmo com הֵם / הֵן. Na fala informal, muita gente usa אַתֶּם e הֵם também para mulheres.",
      "erroPt": "\"Vocês\" é uma palavra só no português. Com um homem no grupo, já é אַתֶּם."
    }
  ],
  "dialogo": {
    "tituloPt": "Natan visita a casa nova da Maya",
    "linhas": [
      {
        "quem": "Natan",
        "he": "מַיָּה, זֶה הַבַּיִת הֶחָדָשׁ?",
        "translit": "Máya, ze habáyit hechadásh?",
        "pt": "Maya, esta é a casa nova?"
      },
      {
        "quem": "Maya",
        "he": "כֵּן! הַבַּיִת קָטָן, אֲבָל יָפֶה.",
        "translit": "ken! habáyit katán, avál yafé.",
        "pt": "Sim! A casa é pequena, mas bonita."
      },
      {
        "quem": "Natan",
        "he": "הַשֻּׁלְחָן חָדָשׁ?",
        "translit": "hashulchán chadásh?",
        "pt": "A mesa é nova?"
      },
      {
        "quem": "Maya",
        "he": "לֹא, הַשֻּׁלְחָן יָשָׁן. אֲבָל הַכִּסְאוֹת חֲדָשִׁים!",
        "translit": "lo, hashulchán yashán. avál hakissót chadashím!",
        "pt": "Não, a mesa é velha. Mas as cadeiras são novas!"
      },
      {
        "quem": "Natan",
        "he": "וּמָה אֵלֶּה?",
        "translit": "umá éle?",
        "pt": "E o que são estas?"
      },
      {
        "quem": "Maya",
        "he": "אֵלֶּה מַתָּנוֹת. הֵן מִנֹּעָה וּמִדָּנִי.",
        "translit": "éle matanót. hen miNóa umiDáni.",
        "pt": "São presentes. São da Noa e do Dani."
      },
      {
        "quem": "Natan",
        "he": "הַמְּנוֹרָה הָאֲדֻמָּה יָפָה מְאֹד!",
        "translit": "hamenorá haadumá yafá meód!",
        "pt": "A luminária vermelha é muito bonita!"
      },
      {
        "quem": "Maya",
        "he": "תּוֹדָה!",
        "translit": "todá!",
        "pt": "Obrigada!"
      }
    ],
