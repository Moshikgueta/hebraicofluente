        "he": "כֵּן. אֵיזוֹ מִדָה?",
        "translit": "ken. éizo midá?",
        "pt": "Tem. Qual tamanho?"
      },
      {
        "quem": "Noa",
        "he": "מֶדְיוּם. אֶפְשָׁר לִמְדוֹד?",
        "translit": "médium. efshár limdód?",
