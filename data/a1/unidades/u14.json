        "he": "בְּטַח. הַתָא שָׁם.",
        "translit": "betách. hatá sham.",
        "pt": "Claro. O provador é ali."
      },
      {
        "quem": "Noa",
        "he": "הִיא קְצָת גְדוֹלָה. יֵשׁ מִדָה יוֹתֵר קְטַנָה?",
        "translit": "hi ktsat gdolá. yesh midá yotér ktaná?",
        "pt": "Ficou um pouco grande. Tem um tamanho menor?"
      },
      {
        "quem": "A vendedora",
        "he": "הִנֵה, סְמוֹל.",
        "translit": "hiné, smol.",
        "pt": "Aqui, pequeno."
      },
      {
        "quem": "Noa",
        "he": "מְצֻיָן! אֲנִי לוֹקַחַת אוֹתָה. אֶפְשָׁר לְשַׁלֵם בְּכַרְטִיס?",
        "translit": "metsuyán! aní lokáchat otá. efshár leshalém bekartís?",
        "pt": "Ótimo! Vou levar. Dá para pagar no cartão?"
      },
      {
        "quem": "A vendedora",
        "he": "כֵּן, בַּקֻפָּה.",
        "translit": "ken, bakupá.",
        "pt": "Dá, no caixa."
