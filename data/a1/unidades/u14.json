        "translit": "hachultsót haéle bemivtsá: shishím shékel.",
        "pt": "Estas blusas estão em promoção: sessenta shekels."
      },
      {
        "quem": "Noa",
        "he": "יֵשׁ בְּכָחֹל?",
        "translit": "yesh bechachól?",
        "pt": "Tem em azul?"
