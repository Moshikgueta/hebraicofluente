  "gramatica": [
    {
      "tituloPt": "Os verbos que terminam em ה",
      "textoPt": "Outro desenho: ־ֶה · ־ָה · ־ִים · ־וֹת (שׁוֹתֶה, שׁוֹתָה, שׁוֹתִים, שׁוֹתוֹת). Os outros seguem o desenho da Unidade 4. קוֹרֵאת é a forma feminina de קוֹרֵא, por causa do א."
    },
    {
      "tituloPt": "O אֶת: uma palavra que não se traduz",
      "textoPt": "Vem antes do objeto quando ele tem \"o/a\": אֲנִי אוֹכֵל אֶת הַלֶּחֶם. Sem \"o/a\", não há אֶת: אֲנִי אוֹכֵל לֶחֶם.",
      "erroPt": "O português não tem essa palavra, então o brasileiro esquece o אֶת, e quando aprende põe em todo lugar. A regra é uma só: אֶת só antes de הַ."
    },
    {
      "tituloPt": "Negar o verbo",
      "textoPt": "לֹא antes dele: אֲנִי לֹא שׁוֹתָה קָפֶה."
    },
    {
      "tituloPt": "\"No/na\" com artigo: בְּ + הַ = בַּ",
      "textoPt": "\"Na cozinha\" = בַּמִּטְבָּח, não בְּהַמִּטְבָּח. E מַיִם é sempre plural, como \"os óculos\".",
      "erroPt": "Juntar as duas peças inteiras (בְּהַ). Elas se fundem numa só: בַּ."
    }
  ],
  "dialogo": {
    "tituloPt": "Café da manhã na casa da Maya",
    "linhas": [
      {
        "quem": "Dani",
        "he": "מַיָּה, מָה אַתְּ אוֹכֶלֶת?",
        "translit": "Maya, ma at ochélet?",
        "pt": "Maya, o que você está comendo?"
      },
      {
        "quem": "Maya",
        "he": "אֲנִי אוֹכֶלֶת לֶחֶם וּגְבִינָה. אַתָּה רוֹצֶה?",
        "translit": "aní ochélet léchem ugviná. atá rotsé?",
        "pt": "Pão e queijo. Você quer?"
      },
      {
        "quem": "Dani",
        "he": "כֵּן, תּוֹדָה. אֵיפֹה הֶחָלָב?",
        "translit": "ken, todá. eifo hechalav?",
        "pt": "Quero, obrigado. Onde está o leite?"
      },
      {
        "quem": "Maya",
        "he": "הֶחָלָב בַּמְּקָרֵר.",
        "translit": "hechalav bamekarer.",
        "pt": "O leite está na geladeira."
      },
      {
        "quem": "Dani",
        "he": "אַתְּ שׁוֹתָה קָפֶה?",
        "translit": "at shotá kafé?",
        "pt": "Você bebe café?"
      },
      {
        "quem": "Maya",
        "he": "לֹא, אֲנִי לֹא שׁוֹתָה קָפֶה. אֲנִי שׁוֹתָה תֵּה.",
        "translit": "lo, aní lo shotá kafé. aní shotá te.",
        "pt": "Não, não bebo café. Bebo chá."
      },
      {
        "quem": "Dani",
        "he": "וּמִי קוֹנֶה אֶת הַלֶּחֶם?",
        "translit": "umi koné et haléchem?",
        "pt": "E quem compra o pão?"
      },
      {
        "quem": "Maya",
        "he": "אַתָּה!",
        "translit": "atá!",
        "pt": "Você!"
      }
