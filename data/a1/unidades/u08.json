  "gramatica": [
    {
      "tituloPt": "O לְ com finais, completo",
      "textoPt": "É o \"para\" grudado: כּוֹתֵב לְךָ (escrevo para você), יֵשׁ לָהֶם (eles têm)."
    },
    {
      "tituloPt": "O mesmo desenho serve para שֶׁל",
      "textoPt": "לָכֶם → שֶׁלָּכֶם, לָהֶם → שֶׁלָּהֶם. Quem sabe uma tabela, sabe a outra."
    },
    {
      "tituloPt": "\"Comigo\" é uma palavra só: אִתִּי",
      "textoPt": "עִם + אֲנִי = אִתִּי.",
      "erroPt": "Dizer עִם אֲנִי (\"com eu\"). O português faz a mesma fusão: \"com + mim\" vira \"comigo\"."
    },
    {
      "tituloPt": "Como se pergunta o nome de verdade",
      "textoPt": "אֵיךְ קוֹרְאִים לְךָ? (\"como te chamam?\"). O מַה שִּׁמְךָ? da Unidade 1 está certo, mas é mais formal.",
      "erroPt": "Responder קוֹרְאִים אֲנִי… A resposta usa o לְ: קוֹרְאִים לִי דָּנִי, como o \"me\" de \"me chamo\"."
    }
