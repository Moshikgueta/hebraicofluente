  "gramatica": [
    {
      "tituloPt": "Em junho, no verão",
      "textoPt": "\"Em\" + mês é בְּ grudado: בְּיוּנִי, בְּמַאי, בְּאוֹגוּסְט. As estações levam artigo: בַּקַּיִץ, בַּחֹרֶף, בָּאָבִיב, בַּסְּתָו. Os nomes dos meses são os internacionais, parecidos com os do português, com sotaque israelense.",
      "exemplos": [
        {
          "he": "יוֹם הַהֻלֶּדֶת שֶׁלִּי בְּמֶרְץ.",
          "pt": "O meu aniversário é em março."
        },
        {
          "he": "בַּחֹרֶף קַר בִּירוּשָׁלַיִם.",
          "pt": "No inverno faz frio em Jerusalém."
        }
      ]
    },
    {
      "tituloPt": "A data: o dia, e depois o mês",
      "textoPt": "A data vem na ordem do português, com בְּ duas vezes: בְּעֶשְׂרִים בְּיוּנִי (em 20 de junho), בִּשְׁלוֹשִׁים בְּאַפְּרִיל (em 30 de abril). Escrita, é como no Brasil: 20/6. Os dias de 1 a 19 têm um detalhe de gênero que fica para a Unidade 19; por enquanto, leia-os nos números.",
      "erroPt": "O americano escreve o mês primeiro (6/20). Em Israel, como no Brasil, o dia vem antes: 20/6."
    },
    {
      "tituloPt": "O tempo, sem \"está\" e sem \"ele\"",
      "textoPt": "Para o tempo não há sujeito: חַם (faz calor), קַר (faz frio), מְעֻנָּן (está nublado). Para a chuva, o hebraico diz que ela \"desce\": יוֹרֵד גֶּשֶׁם. E a temperatura é só o número: שְׁלוֹשִׁים מַעֲלוֹת.",
      "erroPt": "Para dizer que VOCÊ está com frio, não use אֲנִי קַר (\"eu sou frio\"). É קַר לִי, \"está frio para mim\", com o לִי da Unidade 6. Com calor: חַם לִי.",
      "exemplos": [
        {
          "he": "הַיּוֹם קַר, וְיוֹרֵד גֶּשֶׁם.",
          "pt": "Hoje faz frio, e está chovendo."
        },
        {
          "he": "קַר לִי!",
          "pt": "Estou com frio!"
        }
      ]
    },
    {
      "tituloPt": "Amanhã, com o verbo de hoje",
      "textoPt": "Para um plano próximo e certo, o presente serve, como em português: מָחָר אֲנִי עוֹבֵד (amanhã eu trabalho), בַּשָּׁבוּעַ הַבָּא הִיא נוֹסַעַת לְאֵילַת (na semana que vem ela vai para Eilat)."
    }
