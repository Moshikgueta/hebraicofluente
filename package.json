{
  "name": "hebraico-fluente",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Curso de alfabetiza\u00e7\u00e3o em hebraico moderno para brasileiros adultos - gerado a partir de dados.",
  "scripts": {
    "validate": "node scripts/validate.js",
    "check": "npm run validate",
    "audio-manifest": "node tools/gen-audio.mjs",
    "audio-script": "node tools/gen-audio.mjs && node tools/audio-script.mjs",
    "check-audio": "node tools/check-audio.mjs",
    "cortar-audio": "node tools/cortar-audio.mjs",

    "build:platform": "cd app && NEXT_PUBLIC_PLATFORM_API=worker npm run build",
    "deploy": "npm run build:platform && wrangler deploy",
    "db:init": "wrangler d1 execute hebraico-fluente --file=worker/schema.sql --remote",
    "db:init:local": "wrangler d1 execute hebraico-fluente --file=worker/schema.sql --local",
    "db:backup": "bash scripts/backup-d1.sh",
    "db:backup:ensaio": "bash scripts/backup-d1.sh --ensaiar",
    "dev:worker": "npm run build:platform && wrangler dev",
    "test:concessao": "node worker/concessao.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.42.0"
  }
}
